########## Basic Settings ##########
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=""
# Container config directory
CONFIG=""


########## Network UPS Tools ##########
# Username and password
UPS_USER=""
UPS_PASSWORD=""

# Driver name - https://networkupstools.org/stable-hcl.html
UPS_DRIVER=""

# Invoke `lsusb` and find your UPS
# Bus 001 Device 003: ID 0764:0601 Cyber Power System, Inc. PR1500LCDRT2U UPS
# /dev/bus/usb/busnum/devnum
# USB device path is /dev/bus/usb/001/003
UPS_USB_DEVICE=""
# ID vendorid:productid
# Vendor ID is 0764
UPS_VENDORID=""

# Serial number physically printed on unit
UPS_SERIALNUM=""


########## What's Up Docker ##########
# Docker Hub username
DOCKER_LOGIN=""
# Docker Hub login token (https://docs.docker.com/security/for-developers/access-tokens/)
DOCKER_TOKEN=""
# Web UI username
WUD_USERNAME=""
# htpasswd hash for WUD web UI login (only password hash, not username)
WUD_HTPASSWD_HASH=''
# IP of remote docker host to monitor
WUD_REMOTE_HOST=""


########## Network Shutdown (shutdown-network.sh) ##########
# Base URL of the signal-cli REST API container the shutdown script sends through.
# NOTE: must be the base URL only (e.g. http://localhost:8080), NOT the full
# http://localhost:8080/v2/send
# Defaults to http://localhost:8080
SIGNAL_API_ENDPOINT=""
# Signal number registered/linked in the signal container, used as the sender
# e.g. +15551234567
SIGNAL_SENDER=""
# Space-separated recipients - phone numbers and/or group IDs
# (group IDs are listed by GET <endpoint>/v1/groups/<SIGNAL_SENDER>, e.g. group.abc123==)
# e.g. "+15557654321 group.abc123=="
SIGNAL_RECIPIENTS=""
# Machines to shut down over SSH, as user@host -> command to run on it.
# warden must have passwordless SSH to each one (the script runs as root).
# Do not list warden itself - it is always powered off last.
# NOTE: keep each array on ONE line. docker compose also reads this file and
# fails to parse a multi-line array, which breaks the whole stack.
# e.g. SHUTDOWN_CMDS=(["root@server1.lan"]="systemctl poweroff" ["root@router.lan"]="poweroff")
SHUTDOWN_CMDS=()
# Order to shut them down in (bash associative arrays are unordered). Anything
# the others are reached through (switch, router) should come last.
# e.g. SHUTDOWN_ORDER=("root@server1.lan" "root@router.lan")
SHUTDOWN_ORDER=()
