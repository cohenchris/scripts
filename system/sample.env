##### Data Integrity Check #####
# Notification email
EMAIL=""
# Borg backup encryption password in a text file (chmod 600 after creation)
BORG_PASS_FILE=""
# File paths to borg repositories which will be maintained
# Please ensure that you only work on the repositories which have been created by this machine
# i.e. if another machine has created a borg repo on this machine via SSH, do NOT add the repo
# here, add it on the remote machine in SSH format (user@machine:/path/to/remote/repo)
BORG_REPOSITORIES=(
# "/path/to/repo"
# "user@machine:/path/to/remote/repo"
)
# Drives to monitor via S.M.A.R.T. (used by both `test` and `report`)
SMART_DRIVES=(
# "/dev/nvme0n1"
# "/dev/ada0"
)
# Manufacturer TB read (TBR) and TB written (TBW) ratings of each drive above, in TB.
# Order must match SMART_DRIVES: index 0 here describes index 0 there.
# Use "" for drives without a rating (e.g. HDDs) to skip the percentage.
SMART_TBR_RATING=(
# "600"
# "150"
)
SMART_TBW_RATING=(
# "600"
# "150"
)


##### System Update #####
# Used to update Docker stacks
DOCKER_STACKS_HOME_DIR=""


##### Backblaze B2 Bucket Mount #####
# Name of Backblaze B2 rclone remote including the colon (listed in output of `rclone listremotes`)
B2_RCLONE_REMOTE=""


##### System Monitor #####
# Filesystem paths to report disk usage for (disk stats are omitted if empty)
SYSTEM_MONITOR_DISKS=(
# "/"
)
# Network interface to report traffic for (network stats are omitted if empty).
# On a router, use the WAN interface.
SYSTEM_MONITOR_INTERFACE=""


##### WireGuard Uptime #####
# WireGuard interface to monitor (as listed by `wg show`)
WG_INTERFACE=""
# Push-monitor webhook URL
WEBHOOK_URL=""
